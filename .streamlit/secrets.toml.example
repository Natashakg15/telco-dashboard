# Copy this file to secrets.toml and fill in your Snowflake credentials.
# secrets.toml is in .gitignore — never commit real credentials.

[snowflake]
account       = "your_account_identifier"   # e.g. xy12345.ap-southeast-1
user          = "your_username"
password      = "your_password"
warehouse     = "COMPUTE_WH"
database      = "UCONNECT_DW"
schema        = "ANALYTICS"
role          = "your_role"                 # optional
# authenticator = "externalbrowser"         # uncomment for SSO
